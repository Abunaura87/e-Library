<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Folio3D — Interactive 3D Flipbook Reader & Publisher Platform</title>
  <!-- 1. Pustaka Eksternal via CDN Publik Terpercaya -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/page-flip/dist/js/page-flip.browser.js" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/lucide@latest" crossorigin="anonymous"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --font-display: 'Fraunces', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }
    body {
      font-family: var(--font-sans);
    }
    .font-serif-editorial {
      font-family: var(--font-display);
    }
    .font-mono-tabular {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
    }
    .flipbook-stage {
      perspective: 2400px;
    }
    .book-3d-shell {
      transform-style: preserve-3d;
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .page-turn-forward {
      animation: flipForward3D 0.52s cubic-bezier(0.22, 1, 0.36, 1);
      transform-origin: left center;
    }
    .page-turn-backward {
      animation: flipBackward3D 0.52s cubic-bezier(0.22, 1, 0.36, 1);
      transform-origin: right center;
    }
    @keyframes flipForward3D {
      0% { transform: rotateY(-34deg) scale(0.985); filter: brightness(0.88); }
      55% { transform: rotateY(-8deg) scale(0.996); filter: brightness(0.96); }
      100% { transform: rotateY(0deg) scale(1); filter: brightness(1); }
    }
    @keyframes flipBackward3D {
      0% { transform: rotateY(34deg) scale(0.985); filter: brightness(0.88); }
      55% { transform: rotateY(8deg) scale(0.996); filter: brightness(0.96); }
      100% { transform: rotateY(0deg) scale(1); filter: brightness(1); }
    }
    @media print {
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="h-screen overflow-hidden flex flex-col bg-[#F7F4EE] text-[#1C1917] antialiased selection:bg-[#9A3412]/20">
  <!-- Header Navigasi Utama -->
  <header class="no-print shrink-0 flex items-center justify-between gap-8 px-6 py-3 border-b border-stone-300 bg-[#FBF9F5]">
    <a href="#top" id="brand-home" class="text-lg font-bold tracking-tight font-serif-editorial text-stone-900 whitespace-nowrap shrink-0">
      Folio3D
    </a>
    <nav aria-label="Navigasi Utama" class="hidden md:flex items-center gap-6 text-sm font-medium text-stone-600">
      <button type="button" id="nav-split-btn" class="text-stone-950 underline underline-offset-8 decoration-2 decoration-[#9A3412] hover:text-stone-900 transition-colors whitespace-nowrap shrink-0">
        Studio Penerbit
      </button>
      <button type="button" id="nav-reader-btn" class="hover:text-stone-900 transition-colors whitespace-nowrap shrink-0">
        Pembaca 3D Penuh
      </button>
      <button type="button" id="nav-thumbs-btn" class="hover:text-stone-900 transition-colors whitespace-nowrap shrink-0">
        Daftar Isi & Thumbnail
      </button>
      <button type="button" id="nav-theme-btn" class="hover:text-stone-900 transition-colors whitespace-nowrap shrink-0">
        Ganti Tema Kanvas
      </button>
    </nav>
    <div class="flex items-center gap-3 shrink-0">
      <button type="button" id="header-share-btn" class="px-4 py-2 text-xs font-medium text-white bg-[#9A3412] rounded-lg hover:bg-[#7C2D12] transition-colors whitespace-nowrap shrink-0">
        Salin Tautan Baca
      </button>
    </div>
  </header>

  <!-- Notifikasi Toast Mengambang -->
  <div id="toast-box" role="status" aria-live="polite" class="no-print hidden fixed bottom-20 right-6 z-50 px-4 py-2.5 rounded-lg bg-stone-900 text-stone-50 border border-stone-700 text-xs font-medium shadow-xl"></div>

  <!-- Area Kerja Utama -->
  <main class="flex-1 min-h-0 flex flex-col lg:flex-row overflow-hidden">
    <!-- A. MODE PEMILIK / ADMIN (CREATOR DASHBOARD) -->
    <aside id="admin-sidebar" aria-label="Panel Kendali Penerbit" class="no-print w-full lg:w-[420px] xl:w-[440px] shrink-0 border-b lg:border-b-0 lg:border-r border-stone-300/80 bg-[#F7F4EE] text-[#1C1917] overflow-y-auto p-6 space-y-6">
      <div class="border-b border-stone-300/80 pb-4">
        <p class="text-xs font-mono-tabular uppercase tracking-widest text-stone-500">01. Mode Pemilik & Studio Penerbit</p>
        <h1 class="text-xl font-semibold font-serif-editorial text-stone-900 mt-1">Konfigurasi Publikasi 3D Flipbook</h1>
        <p class="text-xs text-stone-600 mt-1 leading-relaxed">
          Unggah berkas PDF lokal, muat tautan PDF eksternal, atau sesuaikan hak akses pembaca secara langsung.
        </p>
      </div>

      <!-- 1. Unggah File PDF Lokal & Direct URL -->
      <section class="space-y-3.5">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-stone-900">01. Sumber Dokumen PDF</h2>
          <span id="source-badge" class="text-xs text-stone-500 font-mono-tabular">Katalog Bawaan</span>
        </div>

        <label id="dropzone-label" for="pdf-file-input" class="flex flex-col items-center justify-center p-5 rounded-lg border border-dashed border-stone-400 bg-[#FBF9F5] hover:border-stone-800 transition-colors cursor-pointer text-center">
          <i data-lucide="upload" class="w-5 h-5 text-[#9A3412] mb-2"></i>
          <span class="text-xs font-semibold text-stone-900">Tarik & Lepas File PDF Lokal atau Klik untuk Memilih</span>
          <span id="file-name-label" class="text-xs text-stone-500 mt-1">Dirender tajam pada layar Retina (window.devicePixelRatio)</span>
          <input id="pdf-file-input" type="file" accept="application/pdf,.pdf" class="sr-only" />
        </label>

        <form id="pdf-url-form" class="space-y-1.5" novalidate>
          <label for="pdf-url-input" class="block text-xs font-medium text-stone-700">Atau Masukkan Direct URL PDF</label>
          <div class="flex items-center gap-2">
            <input id="pdf-url-input" type="url" placeholder="https://mozilla.github.io/pdf.js/web/compressed.tracemonkey-pldi-09.pdf" class="flex-1 px-3 py-2 text-xs bg-[#FBF9F5] border border-stone-300 rounded-lg text-stone-900 placeholder:text-stone-400 focus:outline-none focus:border-stone-800" />
            <button type="submit" class="px-3.5 py-2 text-xs font-medium bg-stone-900 text-white rounded-lg hover:bg-stone-800 transition-colors whitespace-nowrap shrink-0">
              Muat URL
            </button>
          </div>
        </form>

        <div id="error-box" role="alert" class="hidden p-3 rounded-lg bg-red-950/10 border border-red-800/30 text-red-900 text-xs leading-relaxed"></div>
      </section>

      <!-- 2. Pengaturan Identitas Buku -->
      <section class="space-y-3 pt-4 border-t border-stone-300/80">
        <h2 class="text-sm font-semibold text-stone-900">02. Identitas Buku</h2>
        <div>
          <label for="inp-title" class="block text-xs font-medium text-stone-700 mb-1">Judul Buku</label>
          <input id="inp-title" type="text" class="w-full px-3 py-2 text-xs bg-[#FBF9F5] border border-stone-300 rounded-lg text-stone-900" />
        </div>
        <div>
          <label for="inp-author" class="block text-xs font-medium text-stone-700 mb-1">Penulis / Penerbit</label>
          <input id="inp-author" type="text" class="w-full px-3 py-2 text-xs bg-[#FBF9F5] border border-stone-300 rounded-lg text-stone-900" />
        </div>
        <div>
          <label for="inp-desc" class="block text-xs font-medium text-stone-700 mb-1">Deskripsi Singkat</label>
          <textarea id="inp-desc" rows="2" class="w-full px-3 py-2 text-xs bg-[#FBF9F5] border border-stone-300 rounded-lg text-stone-900 leading-relaxed"></textarea>
        </div>
      </section>

      <!-- 3. Panel Kontrol Hak Akses & Fitur Pembaca -->
      <section class="space-y-3 pt-4 border-t border-stone-300/80">
        <h2 class="text-sm font-semibold text-stone-900">03. Hak Akses & Fitur Pembaca</h2>
        <div class="divide-y divide-stone-200 border border-stone-300/80 rounded-lg bg-[#FBF9F5] px-3.5">
          <label class="flex items-center justify-between gap-3 py-2.5 cursor-pointer">
            <div>
              <span class="block text-xs font-medium text-stone-900">Izinkan Unduh PDF Asli</span>
              <span class="block text-[11px] text-stone-500">Sembunyikan tombol & blokir klik kanan jika nonaktif</span>
            </div>
            <input id="chk-download" type="checkbox" class="w-4 h-4 accent-[#9A3412] rounded" />
          </label>
          <label class="flex items-center justify-between gap-3 py-2.5 cursor-pointer">
            <div>
              <span class="block text-xs font-medium text-stone-900">Izinkan Cetak (Print)</span>
              <span class="block text-[11px] text-stone-500">Tampilkan tombol cetak halaman di toolbar pembaca</span>
            </div>
            <input id="chk-print" type="checkbox" class="w-4 h-4 accent-[#9A3412] rounded" />
          </label>
          <label class="flex items-center justify-between gap-3 py-2.5 cursor-pointer">
            <div>
              <span class="block text-xs font-medium text-stone-900">Efek Suara Lembaran Kertas</span>
              <span class="block text-[11px] text-stone-500">Sintesis suara gesekan kertas via Web Audio API</span>
            </div>
            <input id="chk-sound" type="checkbox" class="w-4 h-4 accent-[#9A3412] rounded" />
          </label>
          <label class="flex items-center justify-between gap-3 py-2.5 cursor-pointer">
            <div>
              <span class="block text-xs font-medium text-stone-900">Navigasi Thumbnail & Slider Halaman</span>
              <span class="block text-[11px] text-stone-500">Tampilkan penggeser halaman & laci daftar isi</span>
            </div>
            <input id="chk-thumbs" type="checkbox" class="w-4 h-4 accent-[#9A3412] rounded" />
          </label>
          <div class="py-2.5 space-y-2">
            <label class="flex items-center justify-between gap-3 cursor-pointer">
              <div>
                <span class="block text-xs font-medium text-stone-900">Proteksi Kata Sandi</span>
                <span class="block text-[11px] text-stone-500">Wajibkan kata sandi untuk membuka buku</span>
              </div>
              <input id="chk-password" type="checkbox" class="w-4 h-4 accent-[#9A3412] rounded" />
            </label>
            <div id="password-config-row" class="hidden flex items-center gap-2 pt-1">
              <input id="inp-password" type="text" placeholder="Kata sandi buku..." class="flex-1 px-2.5 py-1.5 text-xs bg-white border border-stone-300 rounded font-mono-tabular" />
              <button type="button" id="btn-test-lock" class="px-2.5 py-1.5 text-xs font-medium bg-stone-900 text-white rounded hover:bg-stone-800 whitespace-nowrap">
                Uji Kunci
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. Generator Tautan Berbagi -->
      <section class="space-y-3 pt-4 border-t border-stone-300/80">
        <h2 class="text-sm font-semibold text-stone-900">04. Generator Tautan Berbagi</h2>
        <div class="flex items-center gap-2">
          <input id="share-url-output" type="text" readonly class="flex-1 px-3 py-2 text-xs font-mono-tabular bg-[#FBF9F5] border border-stone-300 rounded-lg text-stone-700 select-all" />
          <button type="button" id="btn-copy-share" class="px-3.5 py-2 text-xs font-medium bg-[#9A3412] text-white rounded-lg hover:bg-[#7C2D12] whitespace-nowrap">
            Salin URL
          </button>
        </div>
        <button type="button" id="btn-open-reader-mode" class="w-full py-2.5 px-4 text-xs font-medium bg-stone-900 text-white rounded-lg hover:bg-stone-800 transition-colors">
          Buka Mode Pembaca Penuh
        </button>
      </section>
    </aside>

    <!-- B. MODE PEMBACA (E-BOOK 3D FLIPBOOK VIEWER) -->
    <section id="reader-stage" aria-label="Kanvas Pembaca 3D Flipbook" class="relative flex-1 flex flex-col justify-between overflow-hidden select-none bg-[#141312] text-[#F7F4EE] transition-colors duration-200">
      <!-- Baris Informasi Atas Pembaca -->
      <div id="reader-top-strip" class="no-print flex items-center justify-between gap-4 px-5 py-3 border-b border-stone-800 bg-[#181615]/90 z-20">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 text-xs text-stone-400 truncate">
            <span id="reader-author-label" class="truncate">Studio Kuratorial Atelier Meridien</span>
            <span>·</span>
            <span id="reader-spread-mode-label" class="font-mono-tabular">2 Halaman (Spread)</span>
          </div>
          <h2 id="reader-title-label" class="text-base md:text-lg font-semibold font-serif-editorial truncate mt-0.5">
            Arsitektur Cahaya & Ruang Nusantara
          </h2>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" id="btn-back-to-admin" class="hidden px-3 py-1.5 text-xs font-medium rounded-lg border border-stone-700 bg-stone-800 text-stone-100 hover:bg-stone-700">
            Buka Panel Admin
          </button>
          <button type="button" id="btn-stage-theme" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-stone-700 bg-stone-800 text-stone-200 hover:bg-stone-700">
            Kertas Arsip
          </button>
        </div>
      </div>

      <!-- Layar Kunci Kata Sandi (Password Protection Overlay) -->
      <div id="password-gate-modal" class="hidden absolute inset-0 z-30 flex items-center justify-center p-6 bg-black/80 backdrop-blur-sm">
        <div class="w-full max-w-md bg-[#1C1917] border border-stone-700 rounded-xl p-6 text-stone-100 shadow-2xl space-y-4">
          <h3 class="text-lg font-semibold font-serif-editorial">Publikasi Terproteksi Kata Sandi</h3>
          <p class="text-xs text-stone-300 leading-relaxed">Masukkan kata sandi resmi untuk membuka pembaca 3D Flipbook ini.</p>
          <form id="unlock-form" class="space-y-3">
            <input id="unlock-password-input" type="password" placeholder="Ketik kata sandi..." class="w-full px-3.5 py-2 text-xs bg-stone-900 border border-stone-700 rounded-lg text-white" />
            <p id="unlock-error-msg" class="hidden text-xs text-red-400 font-medium"></p>
            <button type="submit" class="w-full py-2.5 text-xs font-semibold bg-[#9A3412] hover:bg-[#7C2D12] text-white rounded-lg">
              Buka Publikasi 3D
            </button>
          </form>
        </div>
      </div>

      <!-- Indikator Loading Render PDF -->
      <div id="loading-overlay" class="hidden absolute inset-0 z-25 flex flex-col items-center justify-center bg-black/65 backdrop-blur-xs text-stone-100 p-6">
        <div class="w-56 h-1.5 bg-stone-800 rounded-full overflow-hidden mb-3">
          <div id="loading-bar" class="h-full bg-[#9A3412] transition-all duration-200" style="width: 25%"></div>
        </div>
        <p class="text-sm font-medium font-serif-editorial">Merender Halaman PDF Resolusi Tinggi (Retina DPI)...</p>
        <p id="loading-progress-text" class="text-xs text-stone-400 font-mono-tabular mt-1">Halaman 1</p>
      </div>

      <!-- Kanvas Utama Buku 3D Flipbook -->
      <div class="relative flex-1 flex items-center justify-center px-4 py-4 md:px-10 overflow-hidden flipbook-stage">
        <button type="button" id="stage-prev-arrow" aria-label="Halaman Sebelumnya" class="no-print hidden sm:flex items-center justify-center w-11 h-11 rounded-full border border-stone-700 bg-[#1C1917]/90 text-stone-100 hover:bg-stone-800 shadow-lg z-20 mr-4 disabled:opacity-25">
          <i data-lucide="chevron-left" class="w-5 h-5"></i>
        </button>

        <div id="book-3d-object" class="book-3d-shell relative flex items-center justify-center cursor-grab active:cursor-grabbing">
          <div class="relative flex items-center justify-center rounded-sm p-2 sm:p-3 bg-[#26211E] shadow-[0_32px_64px_-12px_rgba(0,0,0,0.85),0_0_0_1px_rgba(255,255,255,0.08)]">
            <div id="left-paper-stack" class="hidden sm:block w-2 self-stretch bg-gradient-to-r from-[#D6CEBE] via-[#F5F2EB] to-[#E5DFD3] border-r border-stone-400/50 rounded-l-xs"></div>
            <div id="pages-spread-Mount" class="relative flex items-center justify-center bg-[#FBF9F5]"></div>
            <div id="center-spine-shadow" class="pointer-events-none absolute inset-y-2 left-1/2 -translate-x-1/2 w-12 bg-gradient-to-r from-transparent via-stone-950/35 to-transparent"></div>
            <div class="hidden sm:block w-2 self-stretch bg-gradient-to-l from-[#D6CEBE] via-[#F5F2EB] to-[#E5DFD3] border-l border-stone-400/50 rounded-r-xs"></div>
          </div>
        </div>

        <button type="button" id="stage-next-arrow" aria-label="Halaman Berikutnya" class="no-print hidden sm:flex items-center justify-center w-11 h-11 rounded-full border border-stone-700 bg-[#1C1917]/90 text-stone-100 hover:bg-stone-800 shadow-lg z-20 ml-4 disabled:opacity-25">
          <i data-lucide="chevron-right" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Floating Toolbar Pembaca di Bagian Bawah -->
      <div class="no-print w-full px-4 pb-4 pt-1 flex flex-col items-center gap-2 z-20">
        <div id="slider-bar-container" class="w-full max-w-4xl flex items-center gap-3 px-4 py-1.5 rounded-lg border border-stone-800 bg-[#1C1917]/90 text-stone-300 text-xs">
          <span id="slider-page-label" class="font-mono-tabular text-[11px] whitespace-nowrap">Halaman 1 dari 8</span>
          <input id="page-range-slider" type="range" min="1" max="8" value="1" class="flex-1 h-1.5 accent-[#9A3412] cursor-pointer" />
          <span id="slider-percent-label" class="font-mono-tabular text-[11px] whitespace-nowrap">0%</span>
        </div>

        <div role="toolbar" aria-label="Kontrol Pembaca Flipbook" class="w-full max-w-4xl rounded-xl border border-stone-800 bg-[#1C1917]/95 text-stone-100 px-3.5 py-2.5 shadow-2xl flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-1.5">
            <button type="button" id="toolbar-prev-btn" class="px-2.5 py-1.5 text-xs font-medium rounded-lg hover:bg-stone-800 disabled:opacity-35">Sebelumnya</button>
            <form id="page-jump-form" class="flex items-center gap-1.5 px-1">
              <input id="page-num-input" type="text" value="1" class="w-11 text-center py-1 text-xs font-mono-tabular rounded bg-stone-900 border border-stone-700 text-white" />
              <span id="total-pages-label" class="text-xs font-mono-tabular text-stone-400">dari 8</span>
            </form>
            <button type="button" id="toolbar-next-btn" class="px-2.5 py-1.5 text-xs font-medium rounded-lg hover:bg-stone-800 disabled:opacity-35">Berikutnya</button>
          </div>

          <div class="flex items-center gap-1">
            <button type="button" id="zoom-out-btn" class="px-2 py-1 text-xs rounded hover:bg-stone-800">-</button>
            <span id="zoom-value-label" class="text-xs font-mono-tabular px-1.5">100%</span>
            <button type="button" id="zoom-in-btn" class="px-2 py-1 text-xs rounded hover:bg-stone-800">+</button>
            <button type="button" id="zoom-reset-btn" class="px-2 py-1 text-[11px] text-stone-400 hover:text-white">Reset</button>
          </div>

          <div class="flex items-center gap-1.5 flex-wrap">
            <button type="button" id="toolbar-thumbs-btn" class="px-2.5 py-1.5 text-xs font-medium rounded-lg hover:bg-stone-800">Daftar Isi</button>
            <button type="button" id="toolbar-sound-btn" class="px-2.5 py-1.5 text-xs font-medium rounded-lg hover:bg-stone-800">Suara Aktif</button>
            <button type="button" id="toolbar-print-btn" class="px-2.5 py-1.5 text-xs font-medium rounded-lg hover:bg-stone-800">Cetak</button>
            <button type="button" id="toolbar-download-btn" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-[#9A3412] text-white hover:bg-[#7C2D12]">Unduh PDF</button>
            <button type="button" id="toolbar-share-btn" class="px-2.5 py-1.5 text-xs font-medium rounded-lg hover:bg-stone-800">Bagikan</button>
            <button type="button" id="toolbar-fullscreen-btn" class="px-2.5 py-1.5 text-xs font-medium rounded-lg hover:bg-stone-800">Layar Penuh</button>
          </div>
        </div>
      </div>

      <!-- Laci Geser (Drawer Modal) Daftar Isi & Grid Thumbnail Halaman -->
      <div id="thumbnail-drawer" class="no-print hidden absolute inset-y-0 right-0 z-30 w-full max-w-md bg-[#1C1917] border-l border-stone-700 text-stone-100 shadow-2xl flex flex-col">
        <div class="flex items-center justify-between px-5 py-4 border-b border-stone-800">
          <div>
            <h3 class="text-sm font-semibold font-serif-editorial">Daftar Isi & Grid Thumbnail Halaman</h3>
            <p class="text-xs text-stone-400">Klik halaman untuk melompat langsung ke lembaran terkait.</p>
          </div>
          <button type="button" id="close-thumbs-btn" class="px-2.5 py-1 text-xs rounded bg-stone-800 hover:bg-stone-700">Tutup</button>
        </div>
        <div id="thumbnail-grid" class="flex-1 overflow-y-auto p-5 grid grid-cols-2 gap-4"></div>
      </div>
    </section>
  </main>

  <!-- Logika Aplikasi Vanilla JavaScript -->
  <script>
    (function () {
      if (window.pdfjsLib) {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      const STORAGE_KEY = 'folio3d_standalone_state_v1';

      const SAMPLE_CHAPTERS = [
        { kicker: 'SAMPUL DEPAN · EDISI KOLEKTOR', title: 'Arsitektur Cahaya & Ruang Nusantara', subtitle: 'Dialog Antara Bayangan Tropis, Void, dan Materialitas Jujur', body: 'Katalog Pameran Tahunan & Dokumentasi Tektonik Asia Tenggara. Diterbitkan oleh Studio Kuratorial Atelier Meridien.' },
