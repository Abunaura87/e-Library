      let config = {
        title: 'Arsitektur Cahaya & Ruang Nusantara',
        author: 'Studio Kuratorial Atelier Meridien',
        description: 'Monografi edisi koleksi mengenai dialog antara struktur tropis vernakular, pencahayaan alami, dan tektonika beton kontemporer.',
        allowDownload: true,
        allowPrint: true,
        enableSound: true,
        showThumbnails: true,
        passwordProtected: false,
        password: '',
        readerTheme: 'dark',
        pdfUrl: ''
      };

      let pagesDataUrls = [];
      let currentPage = 1;
      let zoomLevel = 1;
      let viewMode = 'split';
      let isLocked = false;
      let rawPdfBlobUrl = null;
      let audioCtx = null;

      // Utilitas Notifikasi Toast
      function showToast(msg) {
        const box = document.getElementById('toast-box');
        box.textContent = msg;
        box.classList.remove('hidden');
        clearTimeout(box._timer);
        box._timer = setTimeout(() => box.classList.add('hidden'), 2800);
      }

      // Sintesis Suara Kertas via Web Audio API
      function playPaperSound(dir) {
        if (!config.enableSound) return;
        try {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) return;
          if (!audioCtx) audioCtx = new AudioContextClass();
          if (audioCtx.state === 'suspended') audioCtx.resume();

          const duration = 0.22;
          const sampleRate = audioCtx.sampleRate;
          const frameCount = Math.floor(sampleRate * duration);
          const buffer = audioCtx.createBuffer(1, frameCount, sampleRate);
          const data = buffer.getChannelData(0);

          let b0 = 0, b1 = 0, b2 = 0;
          for (let i = 0; i < frameCount; i++) {
            const t = i / frameCount;
            const white = Math.random() * 2 - 1;
            b0 = 0.997 * b0 + white * 0.029;
            b1 = 0.985 * b1 + white * 0.032;
            b2 = 0.950 * b2 + white * 0.048;
            const env = Math.sin(Math.min(1, t * 1.4) * Math.PI) * Math.pow(1 - t, 1.35);
            data[i] = (b0 + b1 + b2 + white * 0.18) * env;
          }

          const src = audioCtx.createBufferSource();
          src.buffer = buffer;
          const filter = audioCtx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(dir === 'prev' ? 820 : 950, audioCtx.currentTime);
          filter.frequency.exponentialRampToValueAtTime(2300, audioCtx.currentTime + duration * 0.55);

          const gain = audioCtx.createGain();
          gain.gain.setValueAtTime(0.01, audioCtx.currentTime);
          gain.gain.linearRampToValueAtTime(0.25, audioCtx.currentTime + 0.03);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

          src.connect(filter);
          filter.connect(gain);
          gain.connect(audioCtx.destination);
          src.start();
        } catch (e) {}
      }

      // Encode & Decode URL Hash Shareable State
      function encodeConfigHash() {
        const json = JSON.stringify(config);
        const b64 = btoa(unescape(encodeURIComponent(json))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        return '#mode=reader&cfg=' + b64;
      }

      function loadFromHashOrStorage() {
        const hash = window.location.hash;
        if (hash && hash.includes('cfg=')) {
          try {
            const params = new URLSearchParams(hash.slice(1));
            let b64 = (params.get('cfg') || '').replace(/-/g, '+').replace(/_/g, '/');
            while (b64.length % 4) b64 += '=';
            const parsed = JSON.parse(decodeURIComponent(escape(atob(b64))));
            config = Object.assign({}, config, parsed);
            if (hash.includes('mode=reader')) {
              viewMode = 'reader';
              if (config.passwordProtected && config.password) isLocked = true;
            }
            return;
          } catch (e) {}
        }
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) config = Object.assign({}, config, JSON.parse(saved));
        } catch (e) {}
      }

      function persistState() {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(config)); } catch (e) {}
        const base = window.location.origin + window.location.pathname;
        document.getElementById('share-url-output').value = base + encodeConfigHash();
      }

      // Render Halaman Katalog Default dengan Ketajaman Retina (devicePixelRatio)
      function renderDefaultMonographPages() {
        const dpr = Math.min(window.devicePixelRatio || 2, 2.5);
        const w = 580, h = 800;
        pagesDataUrls = SAMPLE_CHAPTERS.map((ch, idx) => {
          const canvas = document.createElement('canvas');
          canvas.width = w * dpr;
          canvas.height = h * dpr;
          const ctx = canvas.getContext('2d');
          ctx.scale(dpr, dpr);

          const isCover = idx === 0;
          ctx.fillStyle = isCover ? '#1C1917' : '#FBF9F5';
          ctx.fillRect(0, 0, w, h);

          ctx.strokeStyle = isCover ? 'rgba(255,255,255,0.12)' : '#E5DFD3';
          ctx.strokeRect(36, 36, w - 72, h - 72);

          ctx.fillStyle = isCover ? '#D6CEBE' : '#78716C';
          ctx.font = '600 10px "JetBrains Mono", monospace';
          ctx.fillText(ch.kicker, 56, 74);

          ctx.fillStyle = '#9A3412';
          ctx.fillRect(56, 90, 64, 3);

          ctx.fillStyle = isCover ? '#FBF9F5' : '#1C1917';
          ctx.font = '600 24px "Fraunces", Georgia, serif';
          const titleToDraw = isCover ? config.title : ch.title;
          ctx.fillText(titleToDraw.slice(0, 38), 56, 134);

          ctx.fillStyle = isCover ? '#D6CEBE' : '#9A3412';
          ctx.font = '500 13px "Plus Jakarta Sans", sans-serif';
          ctx.fillText(ch.subtitle.slice(0, 60), 56, 164);

          // Ilustrasi Arsitektur Vektor
          ctx.fillStyle = isCover ? 'rgba(255,255,255,0.04)' : '#F2EFE9';
          ctx.fillRect(56, 195, w - 112, 230);
          ctx.strokeStyle = '#9A3412';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(w / 2, 310, 68, 0, Math.PI * 2);
          ctx.stroke();

          // Teks Paragraf
          ctx.fillStyle = isCover ? '#E7E5E4' : '#292524';
          ctx.font = '400 13.5px "Plus Jakarta Sans", sans-serif';
          const words = (isCover ? config.description : ch.body).split(' ');
          let line = '', y = 470;
          words.forEach((word) => {
            if ((line + ' ' + word).length > 62) {
              ctx.fillText(line, 56, y);
              line = word;
              y += 22;
            } else {
              line = (line + ' ' + word).trim();
            }
          });
          if (line) ctx.fillText(line, 56, y);

          ctx.fillStyle = isCover ? '#A8A29E' : '#57534E';
          ctx.font = '500 11px "JetBrains Mono", monospace';
          ctx.fillText('FOLIO 0' + (idx + 1) + ' / 0' + SAMPLE_CHAPTERS.length + '  ·  ' + config.author.slice(0, 32), 56, h - 54);

          return {
            pageNumber: idx + 1,
            title: isCover ? config.title : ch.title,
            dataUrl: canvas.toDataURL('image/jpeg', 0.92)
          };
        });
        renderStage('forward');
        renderThumbnailsGrid();
      }

      // Render PDF Asli (File Lokal atau Direct URL) via PDF.js
      async function loadPdfDocument(sourceObj, labelName) {
        const overlay = document.getElementById('loading-overlay');
        const bar = document.getElementById('loading-bar');
        const progText = document.getElementById('loading-progress-text');
        const errBox = document.getElementById('error-box');
        errBox.classList.add('hidden');
        overlay.classList.remove('hidden');

        try {
          const loadingTask = window.pdfjsLib.getDocument(sourceObj);
          const pdf = await loadingTask.promise;
          const total = pdf.numPages;
          const dpr = Math.min(window.devicePixelRatio || 2, 2.5);
          const rendered = [];

          for (let i = 1; i <= total; i++) {
            bar.style.width = Math.round((i / total) * 100) + '%';
            progText.textContent = 'Merender Halaman ' + i + ' dari ' + total;
            const page = await pdf.getPage(i);
            const vp1 = page.getViewport({ scale: 1 });
            const scale = (600 / vp1.width) * dpr;
            const viewport = page.getViewport({ scale });

            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            await page.render({ canvasContext: ctx, viewport }).promise;

            rendered.push({
              pageNumber: i,
              title: i === 1 ? 'Sampul Depan' : 'Halaman ' + i,
              dataUrl: canvas.toDataURL('image/jpeg', 0.92)
            });
          }

          pagesDataUrls = rendered;
          currentPage = 1;
          document.getElementById('source-badge').textContent = labelName;
          renderStage('forward');
          renderThumbnailsGrid();
          showToast('Berhasil memuat ' + total + ' halaman PDF.');
        } catch (err) {
          errBox.textContent = 'Gagal memuat file PDF: Pastikan file PDF tidak rusak dan URL mengizinkan akses CORS.';
          errBox.classList.remove('hidden');
        } finally {
          overlay.classList.add('hidden');
        }
      }

      // Perhitungan Spread (2 Halaman di Desktop, 1 Halaman di Mobile)
      function getVisiblePages() {
        const total = pagesDataUrls.length || 1;
        const isMobile = window.innerWidth < 900;
        if (isMobile || currentPage === 1) return [currentPage];
        const left = currentPage % 2 === 0 ? currentPage : currentPage - 1;
        const right = left + 1 <= total ? left + 1 : null;
        return right ? [left, right] : [left];
      }

      function renderStage(direction) {
        const total = pagesDataUrls.length || 1;
        const visible = getVisiblePages();
        const mount = document.getElementById('pages-spread-Mount');
        mount.innerHTML = '';
        mount.className = 'relative flex items-center justify-center bg-[#FBF9F5] ' +
          (direction === 'backward' ? 'page-turn-backward' : 'page-turn-forward');

        visible.forEach((pNo, idx) => {
          const item = pagesDataUrls[pNo - 1];
          if (!item) return;
          const img = document.createElement('img');
          img.src = item.dataUrl;
          img.alt = 'Halaman ' + pNo;
          img.className = 'block h-[44vh] sm:h-[52vh] lg:h-[56vh] max-h-[520px] w-auto object-contain select-none';
          img.onclick = () => {
            if (visible.length === 2 && idx === 0) goPrev();
            else goNext();
          };
          mount.appendChild(img);
        });

        document.getElementById('center-spine-shadow').style.display = visible.length === 2 ? 'block' : 'none';
        document.getElementById('left-paper-stack').style.display = visible.length === 2 ? 'block' : 'none';
        document.getElementById('book-3d-object').style.transform = 'scale(' + zoomLevel + ')';

        // Sinkronisasi teks & kontrol
        const labelText = visible.length === 2
          ? 'Halaman ' + visible[0] + '–' + visible[1] + ' dari ' + total
          : 'Halaman ' + visible[0] + ' dari ' + total;
        document.getElementById('slider-page-label').textContent = labelText;
        document.getElementById('page-num-input').value = visible[0];
        document.getElementById('total-pages-label').textContent = 'dari ' + total;

        const highest = visible[visible.length - 1];
        const pct = total <= 1 ? 100 : Math.round(((highest - 1) / (total - 1)) * 100);
        document.getElementById('slider-percent-label').textContent = pct + '%';

        const slider = document.getElementById('page-range-slider');
        slider.max = total;
        slider.value = visible[0];

        document.getElementById('reader-title-label').textContent = config.title;
        document.getElementById('reader-author-label').textContent = config.author;
        document.getElementById('reader-spread-mode-label').textContent =
          window.innerWidth < 900 ? '1 Halaman (Single)' : '2 Halaman (Spread)';

        // Hak akses & visibilitas fitur
        document.getElementById('toolbar-download-btn').style.display = config.allowDownload ? 'inline-flex' : 'none';
        document.getElementById('toolbar-print-btn').style.display = config.allowPrint ? 'inline-flex' : 'none';
        document.getElementById('slider-bar-container').style.display = config.showThumbnails ? 'flex' : 'none';
        document.getElementById('toolbar-thumbs-btn').style.display = config.showThumbnails ? 'inline-flex' : 'none';
        document.getElementById('toolbar-sound-btn').textContent = config.enableSound ? 'Suara Aktif' : 'Bisu';

        // Mode tampilan Split vs Reader Penuh
        document.getElementById('admin-sidebar').style.display = viewMode === 'split' ? 'block' : 'none';
        document.getElementById('btn-back-to-admin').style.display = viewMode === 'reader' ? 'inline-flex' : 'none';
        document.getElementById('password-gate-modal').classList.toggle('hidden', !isLocked);

        persistState();
      }

      function renderThumbnailsGrid() {
        const grid = document.getElementById('thumbnail-grid');
        grid.innerHTML = '';
        pagesDataUrls.forEach((p) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'flex flex-col items-start p-2.5 rounded-lg border border-stone-800 bg-stone-900/70 hover:border-[#9A3412] text-left transition-all';
          btn.innerHTML =
            '<img src="' + p.dataUrl + '" alt="Thumbnail ' + p.pageNumber + '" class="w-full aspect-[3/4] object-contain bg-stone-950 rounded mb-2" />' +
            '<span class="text-[11px] font-mono-tabular text-stone-400">Halaman ' + p.pageNumber + '</span>' +
            '<span class="text-xs font-medium text-stone-100 truncate w-full">' + p.title + '</span>';
          btn.onclick = () => {
            currentPage = p.pageNumber;
            playPaperSound('next');
            renderStage('forward');
            document.getElementById('thumbnail-drawer').classList.add('hidden');
          };
          grid.appendChild(btn);
        });
      }

      function goNext() {
        if (isLocked) return;
        const total = pagesDataUrls.length;
        const isMobile = window.innerWidth < 900;
        if (currentPage >= total) return;
        currentPage = isMobile || currentPage === 1 ? Math.min(total, currentPage + 1) : Math.min(total, currentPage + 2);
        playPaperSound('next');
        renderStage('forward');
      }

      function goPrev() {
        if (isLocked) return;
        const isMobile = window.innerWidth < 900;
        if (currentPage <= 1) return;
        currentPage = isMobile || currentPage <= 2 ? Math.max(1, currentPage - 1) : Math.max(1, currentPage - 2);
        playPaperSound('prev');
        renderStage('backward');
      }

      // Inisialisasi Event Listeners
      loadFromHashOrStorage();

      // Sinkronisasi Form Admin
      const inpTitle = document.getElementById('inp-title');
      const inpAuthor = document.getElementById('inp-author');
      const inpDesc = document.getElementById('inp-desc');
      const chkDownload = document.getElementById('chk-download');
      const chkPrint = document.getElementById('chk-print');
      const chkSound = document.getElementById('chk-sound');
      const chkThumbs = document.getElementById('chk-thumbs');
      const chkPassword = document.getElementById('chk-password');
      const inpPassword = document.getElementById('inp-password');

      inpTitle.value = config.title;
      inpAuthor.value = config.author;
      inpDesc.value = config.description;
      chkDownload.checked = config.allowDownload;
      chkPrint.checked = config.allowPrint;
      chkSound.checked = config.enableSound;
      chkThumbs.checked = config.showThumbnails;
      chkPassword.checked = config.passwordProtected;
      inpPassword.value = config.password;
      document.getElementById('password-config-row').classList.toggle('hidden', !config.passwordProtected);

      inpTitle.oninput = (e) => { config.title = e.target.value; renderDefaultMonographPages(); };
      inpAuthor.oninput = (e) => { config.author = e.target.value; renderDefaultMonographPages(); };
      inpDesc.oninput = (e) => { config.description = e.target.value; renderDefaultMonographPages(); };
      chkDownload.onchange = (e) => { config.allowDownload = e.target.checked; renderStage('forward'); };
      chkPrint.onchange = (e) => { config.allowPrint = e.target.checked; renderStage('forward'); };
      chkSound.onchange = (e) => { config.enableSound = e.target.checked; renderStage('forward'); };
      chkThumbs.onchange = (e) => { config.showThumbnails = e.target.checked; renderStage('forward'); };
      chkPassword.onchange = (e) => {
        config.passwordProtected = e.target.checked;
        if (config.passwordProtected && !config.password) {
          config.password = 'rahasia2026';
          inpPassword.value = config.password;
        }
        document.getElementById('password-config-row').classList.toggle('hidden', !config.passwordProtected);
        persistState();
      };
      inpPassword.oninput = (e) => { config.password = e.target.value; persistState(); };

      document.getElementById('btn-test-lock').onclick = () => {
        isLocked = true;
        renderStage('forward');
      };

      document.getElementById('unlock-form').onsubmit = (e) => {
        e.preventDefault();
        const val = document.getElementById('unlock-password-input').value.trim();
        if (val === config.password.trim()) {
          isLocked = false;
          document.getElementById('unlock-error-msg').classList.add('hidden');
          renderStage('forward');
          showToast('Kata sandi benar. Selamat membaca!');
        } else {
          const msg = document.getElementById('unlock-error-msg');
          msg.textContent = 'Kata sandi tidak sesuai. Silakan coba lagi.';
          msg.classList.remove('hidden');
        }
      };

      // Unggah PDF Lokal
      document.getElementById('pdf-file-input').onchange = async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        document.getElementById('file-name-label').textContent = 'Aktif: ' + file.name;
        config.title = file.name.replace(/\.pdf$/i, '');
        inpTitle.value = config.title;
        if (rawPdfBlobUrl) URL.revokeObjectURL(rawPdfBlobUrl);
        rawPdfBlobUrl = URL.createObjectURL(file);
        const buf = await file.arrayBuffer();
        loadPdfDocument({ data: new Uint8Array(buf) }, 'PDF Lokal');
      };

      // Muat Direct URL PDF
      document.getElementById('pdf-url-form').onsubmit = (e) => {
        e.preventDefault();
        const url = document.getElementById('pdf-url-input').value.trim();
        if (!url) return;
        config.pdfUrl = url;
        loadPdfDocument({ url }, 'URL Eksternal');
      };

      // Navigasi Tombol, Keyboard, & Drag/Swipe
      document.getElementById('stage-prev-arrow').onclick = goPrev;
      document.getElementById('stage-next-arrow').onclick = goNext;
      document.getElementById('toolbar-prev-btn').onclick = goPrev;
      document.getElementById('toolbar-next-btn').onclick = goNext;

      document.getElementById('page-range-slider').oninput = (e) => {
        currentPage = parseInt(e.target.value, 10) || 1;
        playPaperSound('next');
        renderStage('forward');
      };

      document.getElementById('page-jump-form').onsubmit = (e) => {
        e.preventDefault();
        const p = parseInt(document.getElementById('page-num-input').value, 10);
        if (!isNaN(p)) {
          currentPage = Math.max(1, Math.min(pagesDataUrls.length, p));
          playPaperSound('next');
          renderStage('forward');
        }
      };

      window.addEventListener('keydown', (e) => {
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;
        if (e.key === 'ArrowRight') goNext();
        if (e.key === 'ArrowLeft') goPrev();
      });

      // Mouse Drag & Touch Swipe pada Buku 3D
      let dragStartX = null;
      const bookObj = document.getElementById('book-3d-object');
      bookObj.addEventListener('pointerdown', (e) => { dragStartX = e.clientX; });
      bookObj.addEventListener('pointerup', (e) => {
        if (dragStartX === null) return;
        const delta = e.clientX - dragStartX;
        dragStartX = null;
        if (delta < -40) goNext();
        else if (delta > 40) goPrev();
      });

      // Proteksi Klik Kanan Kanvas saat Download Dinonaktifkan
      document.getElementById('reader-stage').addEventListener('contextmenu', (e) => {
        if (!config.allowDownload) {
          e.preventDefault();
          showToast('Proteksi Hak Cipta Aktif: Klik kanan dan unduhan dinonaktifkan oleh penerbit.');
        }
      });

      // Zoom, Sound, Print, Download, Fullscreen, Share
      document.getElementById('zoom-in-btn').onclick = () => {
        zoomLevel = Math.min(1.5, +(zoomLevel + 0.15).toFixed(2));
        document.getElementById('zoom-value-label').textContent = Math.round(zoomLevel * 100) + '%';
        renderStage('forward');
      };
      document.getElementById('zoom-out-btn').onclick = () => {
        zoomLevel = Math.max(0.75, +(zoomLevel - 0.15).toFixed(2));
        document.getElementById('zoom-value-label').textContent = Math.round(zoomLevel * 100) + '%';
        renderStage('forward');
      };
      document.getElementById('zoom-reset-btn').onclick = () => {
        zoomLevel = 1;
        document.getElementById('zoom-value-label').textContent = '100%';
        renderStage('forward');
      };

      document.getElementById('toolbar-sound-btn').onclick = () => {
        config.enableSound = !config.enableSound;
        chkSound.checked = config.enableSound;
        renderStage('forward');
      };

      document.getElementById('toolbar-print-btn').onclick = () => {
        if (config.allowPrint) window.print();
      };

      document.getElementById('toolbar-download-btn').onclick = () => {
        if (!config.allowDownload) return;
        const link = document.createElement('a');
        link.href = rawPdfBlobUrl || config.pdfUrl || pagesDataUrls[0].dataUrl;
        link.download = (config.title || 'publikasi') + (rawPdfBlobUrl || config.pdfUrl ? '.pdf' : '-cover.jpg');
        link.click();
        showToast('Mengunduh berkas publikasi...');
      };

      function copyReaderShareUrl() {
        const url = document.getElementById('share-url-output').value;
        window.location.hash = encodeConfigHash();
        if (navigator.clipboard) navigator.clipboard.writeText(url).catch(() => {});
        showToast('Tautan baca berhasil disalin ke papan klip!');
      }

      document.getElementById('btn-copy-share').onclick = copyReaderShareUrl;
      document.getElementById('header-share-btn').onclick = copyReaderShareUrl;
      document.getElementById('toolbar-share-btn').onclick = copyReaderShareUrl;

      document.getElementById('toolbar-thumbs-btn').onclick = () => {
        document.getElementById('thumbnail-drawer').classList.toggle('hidden');
      };
      document.getElementById('nav-thumbs-btn').onclick = () => {
        document.getElementById('thumbnail-drawer').classList.toggle('hidden');
      };
      document.getElementById('close-thumbs-btn').onclick = () => {
        document.getElementById('thumbnail-drawer').classList.add('hidden');
      };

      document.getElementById('toolbar-fullscreen-btn').onclick = () => {
        const stage = document.getElementById('reader-stage');
        if (!document.fullscreenElement) stage.requestFullscreen().catch(() => {});
        else document.exitFullscreen().catch(() => {});
      };

      // Mode Tampilan & Tema
      document.getElementById('nav-split-btn').onclick = () => { viewMode = 'split'; renderStage('forward'); };
      document.getElementById('btn-back-to-admin').onclick = () => { viewMode = 'split'; renderStage('forward'); };
      document.getElementById('nav-reader-btn').onclick = () => { viewMode = 'reader'; renderStage('forward'); };
      document.getElementById('btn-open-reader-mode').onclick = () => { viewMode = 'reader'; renderStage('forward'); };

      function toggleTheme() {
        config.readerTheme = config.readerTheme === 'dark' ? 'archival' : 'dark';
        const stage = document.getElementById('reader-stage');
        stage.className = 'relative flex-1 flex flex-col justify-between overflow-hidden select-none transition-colors duration-200 ' +
          (config.readerTheme === 'dark' ? 'bg-[#141312] text-[#F7F4EE]' : 'bg-[#EBE6DF] text-[#1C1917]');
        persistState();
      }
      document.getElementById('btn-stage-theme').onclick = toggleTheme;
      document.getElementById('nav-theme-btn').onclick = toggleTheme;

      window.addEventListener('resize', () => renderStage('forward'));

      // Render awal
      renderDefaultMonographPages();
      if (window.lucide) window.lucide.createIcons();
    })();
  </script>
</body>
</html>